            "type": "command",
            "command": "sh -c 'umask 077; d=\"$HOME/.tracon\"; f=\"$d/spool.ndjson\"; mkdir -p \"$d\"; s=$(wc -c 2>/dev/null < \"$f\" | tr -d \" \"); [ \"${s:-0}\" -gt 52428800 ] && exit 0; { printf \"{\\\"ts\\\":\\\"%s\\\",\\\"payload\\\":\" \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"; tr -d \"\\n\\r\"; printf \"}\\n\"; } >> \"$f\"; chmod 600 \"$f\"; exit 0'",
            "async": true
          }
        ]
      }
    ],
