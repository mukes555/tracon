{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'curl -s -m 5 -X POST -H \"content-type: application/json\" -H \"X-Tracon-Token: $(cat \"$HOME/.tracon/token\" 2>/dev/null)\" --data-binary @- http://localhost:48620/ingest -o /dev/null; exit 0'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'curl -s -m 1 -X POST -H \"content-type: application/json\" -H \"X-Tracon-Token: $(cat \"$HOME/.tracon/token\" 2>/dev/null)\" --data-binary @- http://localhost:48620/ingest -o /dev/null; exit 0'",
            "timeout": 2
          }
        ]
      }
    ],
